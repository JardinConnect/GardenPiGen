[Unit]
Description=Garden IoT Pi5 Gateway Service
After=network-online.target mosquitto.service
Wants=network-online.target mosquitto.service
Requires=mosquitto.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/garden-iot-pi5
Environment="PATH=/opt/garden-iot-pi5/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
ExecStartPre=/bin/sleep 30
ExecStartPre=/bin/bash -c 'for i in {1..60}; do (echo > /dev/tcp/127.0.0.1/1883) >/dev/null 2>&1 && exit 0; sleep 1; done; echo "MQTT broker not ready on 127.0.0.1:1883"; exit 1'
ExecStart=/opt/garden-iot-pi5/venv/bin/python /opt/garden-iot-pi5/main.py
Restart=always
RestartSec=10
StartLimitInterval=200
StartLimitBurst=5

[Install]
WantedBy=multi-user.target